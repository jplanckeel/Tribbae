<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Palette « feu de camp » : fond sable, barres système assorties -->
    <style name="Theme.Tribbae" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/sable</item>
        <item name="android:statusBarColor">@color/sable</item>
        <item name="android:navigationBarColor">@color/sable</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">@color/terracotta</item>
    </style>

    <!-- Écran de lancement (Android 7 à 11 : icône fixe, l'animation n'y est pas prise en charge) -->
    <style name="Theme.Tribbae.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/logo_orange</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Tribbae</item>
    </style>
</resources>
