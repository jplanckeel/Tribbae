MONGO_URI=mongodb://localhost:27017
MONGO_DB=tribbae
JWT_SECRET=change-me-in-production
PORT=8080
GRPC_PORT=9090
BASE_URL=http://localhost:8080
OLLAMA_URL=http://localhost:11434
# Petit modèle CPU, téléchargé automatiquement au démarrage s'il manque
OLLAMA_MODEL=qwen3:1.7b
# Maintien du modèle en mémoire entre deux demandes ; threads CPU (0 = auto)
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_THREAD=0
SEARXNG_URL=http://localhost:8888
# Clé ollama.com (facultative) : recherche web par l'API d'Ollama, SearXNG en repli
OLLAMA_API_KEY=
# Comptes premium : idées rédigées par Gemini (repli sur Ollama en cas d'erreur)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Compte admin (tribbae@bananaops.cloud), créé seulement si défini (≥ 12 caractères)
ADMIN_PASSWORD=
# Origines web tierces autorisées en CORS (séparées par des virgules) — vide par défaut
CORS_ALLOWED_ORIGINS=
