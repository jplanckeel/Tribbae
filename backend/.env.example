MONGO_URI=mongodb://localhost:27017
MONGO_DB=tribbae
JWT_SECRET=change-me-in-production
PORT=8080
GRPC_PORT=9090
BASE_URL=http://localhost:8080
# Adresse publique du site : adresses canoniques, plan du site, aperçus de partage
SITE_URL=https://tribbae.fr
# Autres noms du site (ancien domaine, www) : tout est redirigé vers SITE_URL
REDIRECT_HOSTS=tribbae.bananaops.cloud,www.tribbae.fr
OLLAMA_URL=http://localhost:11434
# Petit modèle CPU, téléchargé automatiquement au démarrage s'il manque
OLLAMA_MODEL=qwen3:1.7b
# Maintien du modèle en mémoire entre deux demandes ; threads CPU (0 = auto)
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_THREAD=0
# Compte admin (tribbae@bananaops.cloud), créé seulement si défini (≥ 12 caractères)
ADMIN_PASSWORD=
# Origines web tierces autorisées en CORS (séparées par des virgules) — vide par défaut
CORS_ALLOWED_ORIGINS=
# Emails transactionnels via Brevo (bienvenue, tribu, suppression du compte).
# Sans clé, les emails sont seulement journalisés. L'expéditeur doit être un
# domaine authentifié dans Brevo (SPF, DKIM).
BREVO_API_KEY=
MAIL_FROM=contact@tribbae.fr
MAIL_FROM_NAME=Tribbae
# Adresse du bouton « Écrire au support » (MAIL_FROM par défaut)
SUPPORT_EMAIL=
# Serveur MCP (/mcp) et autorisation OAuth des applications connectées
# (connecteur Claude). Désactivé par défaut : ces routes répondent alors 404.
MCP_ENABLED=false
# Adresses de retour OAuth acceptées (comparaison exacte), séparées par des virgules
OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
# Idées qu'un compte peut ajouter par le serveur MCP sur 24 h glissantes
MCP_DAILY_CREATE_QUOTA=30
# En-têtes Origin acceptés sur /mcp en plus de SITE_URL (une requête sans Origin passe)
MCP_ALLOWED_ORIGINS=https://claude.ai,https://claude.com
# Empreintes SHA-256 des certificats de l'app Android (séparées par des virgules),
# publiées dans /.well-known/assetlinks.json pour ouvrir les liens tribbae.fr dans
# l'app. Play Console → Intégrité de l'application → clé de signature et clé
# d'importation. Vide : le fichier répond 404.
ANDROID_CERT_FINGERPRINTS=
