  "paths": {
    "/v1/shopping": {
      "get": {
        "operationId": "ShoppingService_GetShoppingList",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetShoppingListResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "sinceVersion",
            "description": "Version déjà connue : si rien n'a changé, la réponse est vide (unchanged)",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          }
        ],
        "tags": [
          "ShoppingService"
        ]
      }
    },
    "/v1/shopping/ops": {
