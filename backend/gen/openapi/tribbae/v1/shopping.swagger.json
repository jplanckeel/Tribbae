          "type": "string",
          "title": "Rayon (voir ShoppingList.aisle_order) ; vide = rangé par le dictionnaire du client"
        },
        "addedBy": {
          "type": "string"
        },
        "addedAt": {
          "type": "string",
          "format": "int64"
        }
      },
      "description": "Un article ajouté à la main (« Lait », « Couches taille 4 »)."
    },
