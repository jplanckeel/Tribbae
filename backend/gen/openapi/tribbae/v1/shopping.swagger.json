          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1ShoppingItem"
          }
        },
        "checked": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1ShoppingCheck"
          }
        },
        "quantities": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1ShoppingProductValue"
          },
          "title": "Quantités tapées à la main (clé du produit → quantité affichée)"
        },
        "aisles": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1ShoppingProductValue"
          },
          "title": "Rayon choisi à la main pour un produit, retenu pour la tribu"
        },
        "aisleOrder": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "Ordre des rayons de la tribu (vide = ordre par défaut des clients)"
        },
        "pantry": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "Produits de base qu'on a déjà (« on en a »), retenus d'une liste à l'autre"
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "Ingrédients de recette retirés de cette liste (clé du produit)"
        },
        "shopperId": {
          "type": "string",
          "title": "« X est en magasin » (vide sinon, oublié après 2 h)"
        },
        "shoppingSince": {
          "type": "string",
          "format": "int64"
        }
      }
    },
    "v1ShoppingMenuEntry": {
      "type": "object",
      "properties": {
        "linkId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "imageUrl": {
          "type": "string"
        },
        "ingredients": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "baseServings": {
          "type": "integer",
          "format": "int32",
          "title": "Nombre de personnes prévu par la recette (4 si elle ne le précise pas)"
        },
        "servings": {
          "type": "integer",
          "format": "int32",
          "title": "Parts choisies pour ce menu"
        },
        "addedBy": {
          "type": "string"
        },
        "addedAt": {
          "type": "string",
          "format": "int64"
        },
        "cooked": {
          "type": "boolean",
          "title": "Marquée « C'est fait » depuis son ajout : la carte s'estompe, et la\nrecette quitte le menu le lendemain"
        }
      },
      "description": "Une recette au menu, avec ce qu'il faut pour en tirer les ingrédients."
    },
    "v1ShoppingOp": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "title": "menu_add (link_id, servings facultatif), menu_servings (link_id, servings),\nmenu_remove (link_id), item_add (label, quantity, aisle ; id facultatif,\nchoisi par le client pour rejouer sans doublon), item_update (id, label,\nquantity, aisle), item_remove (id), check / uncheck (key), quantity (key,\nvalue ; vide efface), aisle (key, value ; vide efface), aisle_order (order),\npantry_have / pantry_out (key), remove / restore (key), shopping_start,\nshopping_stop, finish (vide le panier, garde menu et placard), clear\n(nouvelle liste : tout sauf le placard, les rayons et leur ordre)"
        },
        "linkId": {
          "type": "string"
        },
        "servings": {
          "type": "integer",
          "format": "int32"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "quantity": {
          "type": "string"
        },
        "aisle": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Un changement de la liste. Les opérations s'appliquent dans l'ordre ; deux\npersonnes qui changent la même ligne : la dernière l'emporte."
    },
    "v1ShoppingProductValue": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "description": "Une valeur retenue pour un produit (clé normalisée du produit)."
    }
