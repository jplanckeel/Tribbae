          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "isAdmin": {
          "type": "boolean"
        },
        "isPremium": {
          "type": "boolean",
          "title": "Tribbae+ (accès Perplexity)"
        },
        "createdAt": {
          "type": "string",
          "format": "int64"
        }
      }
    }
  }
}
