            "type": "object",
            "$ref": "#/definitions/v1StatsPoint"
          }
        },
        "publicIdeas": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1StatsPoint"
          }
        },
        "privateIdeas": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1StatsPoint"
          }
        },
        "newUsers": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1StatsPoint"
          }
        },
        "activeUsers": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1StatsPoint"
          },
          "description": "Comptes dont la dernière activité tombe dans la période : on ne garde que\nla dernière, donc les périodes passées sont sous-estimées."
        },
        "totals": {
          "$ref": "#/definitions/v1StatsTotals"
        }
      },
      "description": "Séries alignées : chacune a exactement count points, du plus ancien au plus\nrécent (la dernière période est en cours)."
    },
    "v1ListReportsResponse": {
      "type": "object",
      "properties": {
        "reports": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Report"
          }
        }
      }
    },
    "v1ListUsersResponse": {
      "type": "object",
      "properties": {
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1User"
          }
        }
      }
    },
    "v1Report": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "targetType": {
          "type": "string"
        },
        "targetId": {
          "type": "string"
        },
        "targetOwnerId": {
          "type": "string"
        },
        "targetOwnerName": {
          "type": "string"
        },
        "targetSummary": {
          "type": "string",
          "title": "Titre de l'idée, texte du commentaire ou nom du compte au moment du signalement"
        },
        "reason": {
          "type": "string"
        },
        "details": {
          "type": "string"
        },
        "reporterName": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "title": "\"open\" | \"resolved\" | \"dismissed\""
        },
        "action": {
          "type": "string",
          "title": "Action prise : \"remove\" | \"suspend\" | \"dismiss\""
        },
        "createdAt": {
          "type": "string",
          "format": "int64"
        },
        "linkId": {
          "type": "string",
          "title": "Idée commentée (signalement d'un commentaire), pour l'ouvrir"
        }
      },
      "description": "Signalement vu par l'administration (regroupés par contenu côté clients)."
    },
    "v1ResolveReportResponse": {
      "type": "object"
    },
    "v1StatsPoint": {
      "type": "object",
      "properties": {
        "bucketStart": {
          "type": "string",
          "format": "date-time"
        },
        "count": {
          "type": "string",
          "format": "int64"
        }
      },
      "description": "Un point d'une série : le nombre d'éléments de la période commençant à\nbucket_start (lundi 0 h ou 1er du mois 0 h, heure de Paris)."
    },
    "v1StatsTotals": {
      "type": "object",
      "properties": {
