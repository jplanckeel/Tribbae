          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "period",
            "description": "\"week\" (défaut) ou \"month\"",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "count",
            "description": "nombre de périodes, 12 par défaut, 52 au plus",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "AdminService"
        ]
      }
    },
