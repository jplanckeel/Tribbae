        },
        "publicIdeas": {
          "type": "string",
          "format": "int64"
        },
        "privateIdeas": {
          "type": "string",
          "format": "int64"
        },
        "newUsers": {
          "type": "string",
          "format": "int64"
        },
        "activeUsers": {
          "type": "string",
          "format": "int64"
        }
      },
      "title": "Totaux sur toute la fenêtre"
    },
    "v1UpdateUserPremiumResponse": {
      "type": "object",
      "properties": {
